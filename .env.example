DATABASE_URL=postgres://relayshelf:CHANGE_ME@127.0.0.1:5432/relayshelf
STORAGE_ROOT=/storage
STAGING_ROOT=/staging
APP_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
CSRF_SECRET=<base64-encoded-random-secret>
PUBLIC_ORIGIN=http://localhost:8080
TRUSTED_PROXIES=
FILE_FINALIZE_CONCURRENCY=1
THUMBNAIL_WORKERS=1
MAX_ACTIVE_CHUNK_WRITES=8
UPLOAD_STAGING_MAX_BYTES=34359738368
STAGING_MIN_FREE_BYTES=10737418240
STAGING_MIN_FREE_PERCENT=10
# Public-exposure safety gate: set to yes only after APP_ENCRYPTION_KEY has a
# confirmed off-machine backup. `relayshelf security check` reports this.
RELAYSHELF_KEY_BACKUP_CONFIRMED=
