#!/bin/sh
set -eu

mount_path=${1:-/mnt/relayshelf}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "${STORAGE_COMMON:-$script_dir/relayshelf-storage-common}"

if ! storage_identity "$mount_path"; then
  echo "RelayShelf storage preflight: $mount_path is not a mounted NFS filesystem" >&2
  exit 1
fi

if ! storage_stat_probe "$mount_path" >/dev/null 2>&1; then
  echo "RelayShelf storage preflight: $mount_path filesystem access probe failed" >&2
  exit 1
fi

if [ ! -r "$mount_path" ] || [ ! -w "$mount_path" ] || [ ! -x "$mount_path" ]; then
  echo "RelayShelf storage preflight: $mount_path lacks root read/write/traverse access" >&2
  exit 1
fi

echo "RelayShelf storage preflight: mounted NFS verified at $mount_path"
