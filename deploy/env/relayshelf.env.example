# Install as /etc/relayshelf/relayshelf.env with owner root:root and mode 0600.
# Generate independent secrets with: openssl rand -base64 32
DATABASE_URL=postgres://relayshelf:<url-encoded-database-password>@relayshelf-postgres:5432/relayshelf?sslmode=disable
STORAGE_ROOT=/storage
STAGING_ROOT=/staging
APP_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
CSRF_SECRET=<base64-encoded-independent-32-byte-secret>
PUBLIC_ORIGIN=https://<public-domain>
# CIDR containing only the OpenWrt reverse-proxy address (example: 192.0.2.1/32).
TRUSTED_PROXIES=<openwrt-ip>/32
FILE_FINALIZE_CONCURRENCY=1
THUMBNAIL_WORKERS=1
MAX_ACTIVE_CHUNK_WRITES=8
UPLOAD_STAGING_MAX_BYTES=34359738368
STAGING_MIN_FREE_BYTES=10737418240
STAGING_MIN_FREE_PERCENT=10
# Operator attestations: leave blank until each real qualification is complete.
RELAYSHELF_KEY_BACKUP_CONFIRMED=
RELAYSHELF_TLS_TERMINATION_CONFIRMED=
RELAYSHELF_PROXY_CONFIG_CONFIRMED=

